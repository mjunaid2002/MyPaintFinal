@model IEnumerable<WebApplication1.QueryViewModel.SaleRecoveryReport>
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
   
    var s_date = ViewBag.StartDate;
    string PINV = "PINV";
    string SINV = "SINV";
 
}

<script type="text/javascript">
    function printDiv(divName) {
        var printContents = document.getElementById(divName).innerHTML;
        var originalContents = document.body.innerHTML;

        document.body.innerHTML = printContents;

        window.print();

        document.body.innerHTML = originalContents;
    }</script>
<div class="content">
    <div class="content-header">
        <div class="leftside-content-header">
            <ul class="breadcrumbs">
                <li><a><i class="fa fa-cubes" aria-hidden="true"></i> Sale & Recovery Report</a></li>
            </ul>
        </div>
    </div>
    <button type="button" onclick="printDiv('printableArea')" class="btn btn-info pull-right"><i class="fa fa-print"></i> Print</button>
    <div class="row" id="printableArea">
        <div class="col-sm-12">
            <div class="panel">
                <div class="panel-content">
                    <div class="table-responsive">
                        <center>
                            <br />
                            Sale & Recovery Report</br/>
                            @*<b><u>@viewbag.itemname</u></b>*@
                            <br />@Convert.ToDateTime(ViewBag.StartDate).ToString("dd-MM-yyyy") To @Convert.ToDateTime(ViewBag.EndDate).ToString("dd-MM-yyyy")</br/></br/></br/>
                        </center>
                        <table class="table table-bordered table-hover table-striped table-success"  id="searchable">
                            <thead class="bordered-darkorange">
                                <!--<tr>
                                    <th></th>
                                    <th></th>
                                    <th></th>
                                    <th></th>
                                    <th></th>
                                    <th colspan="2">-->
                                        @*(opening<u>
                                            <span id="demo"></span>
                                            <script>
                                                var y = @(viewbag.openingdubbi);
                                                var x = y.tostring().replace(/\b(?=(\d{3})+(?!\d))/g, ",");
                                                document.getelementbyid("demo").innerhtml = x;
                                            </script>
                                            )*@
                                        <!--</u>
                                    </th>
                                </tr>-->
                                <tr>
                                    <th>Id</th>
                                    <th>Name</th>
                                    <th>Opening</th>
                                    <th>Sales</th>
                                    <th>Recovery</th>
                                 
                                    <th>BAL</th>

                                </tr>
                            </thead>
                            <tbody>
                                <span style="color:white"></span>
                                @foreach (var item in Model.Where(x=>x.closingBalance!=0))
                                {
                                    <tr>
                                        <td>@item.custid</td>
                                     
                                   
                                        <td>@item.custname</td>
                                        <td>@String.Format("{0:N}", item.opening_balance)</td>
                                        <td>@String.Format("{0:N}", item.sales)</td>
                                        <td>@String.Format("{0:N}", item.recovery)</td>
                                        <td>@String.Format("{0:N}", (item.opening_balance + item.sales - item.recovery) )</td>
                                    </tr>
                                }
                                @*<tr>
                                    <th colspan="3"> Grand Total</th>
                                    <th>@tot_In</th>
                                    <th>@tot_out</th>
                                    <th>@tot_bal</th>
                                </tr>*@
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
