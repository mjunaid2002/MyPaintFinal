@model IEnumerable<WebApplication1.QueryViewModel.Customers>
@{
    ViewBag.Title = "Index";
    var ishidden = "hidden";
    if (Session["CurrentUserName"]?.ToString() == "Super Admin")
    {
        ishidden = "";

    }
}
<script>
    $('#searchable').DataTable({
        buttons: [
            'copy', 'excel', 'pdf'
        ]
    });
</script>
<div class="content">
    <div class="content-header">
        <div class="leftside-content-header">
            <ul class="breadcrumbs">
                <li><a><i class="fa fa-cubes" aria-hidden="true"></i> Registrations</a></li>
            </ul>
        </div>
    </div>
    <div class="row">
        <div class="col-sm-12">
            <h4 class="section-subtitle"><b> Customers List</b></h4>
            <a href="@Url.Action("Create", "Customer")" class="btn btn-wide btn-success pull-right" style="margin-top:-40px"><i class="fa fa-plus"></i>  Creat New</a>
            <div class="panel">
                <div class="panel-content">
                    <div class="table-responsive">
                        <table class="table table-bordered table-hover table-striped table-success" id="searchable">
                            <thead class="bordered-darkorange">
                                <tr>
                                    <th>ID</th>
                                    <th>Account no</th>
                                    <th> Branch</th>
                                    <th> BeltArea</th>
                                    <th> Name</th>
                                    <th>Address</th>
                                    <th>Phone</th>
                                    <th>Email</th>
                                    <th>WHT</th>
                                    <th>NTN</th>
                                    <th>CNIC</th>
                                    <th>STRN</th>
                                    <th>IsFiler</th>
                                    <th>Acc Limit</th>
                                    <th class="@ishidden">IsLimitCheck</th>
                                    <th>Day Limit</th>
                                    <th>Booking Detail</th>
                                    <th>Action</th>
                                </tr>
                            </thead>

                            <tbody class="abc">
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>@item.customerid</td>
                                        <td>@item.accno</td>
                                        <td>@item.BranchName</td>
                                        <td>@item.BeltAreaName</td>
                                        <td>@item.Name</td>
                                        <td>@item.Address</td>
                                        <td>@item.Phone</td>
                                        <td>@item.email</td>
                                        <td>@item.partywht</td>
                                        <td>@item.NTN</td>
                                        <td>@item.CNIC</td>
                                        <td>@item.STRN</td>
                                        <td>@item.isFiler</td>
                                        <td>@item.creditlimitamount</td>
                                        <td class="@ishidden">
                                            
                                            @item.iscreditlimitcheck
                                            
                                            <a href="@Url.Action("iscreditlimitcheck", new { ID= item.customerid,check = @item.iscreditlimitcheck} )" new { onclick="return confirm('Are you sure you want to change the credit limit check?');" class="btn btn-info btn-sm shiny input-xs"><i class="fa fa-check"></i></a>

                                                                            </td>
                                        <td>@item.creditlimitdays</td>
                                        <td>@item.BookingDetail</td>
                                        <td>
                                            <a href="@Url.Action("Edit", new { ID= item.customerid } )" new { onclick="return confirm('Are you sure you want to Edit this record?');" class="btn btn-warning shiny input-xs"><i class="fa fa-pencil"></i></a>
                                            <a href="@Url.Action("Delete", new { ID= item.customerid } )" new { onclick="return confirm('Are you sure you want to delete this record?');" class="btn btn-danger shiny input-xs"><i class="fa fa-trash-o"></i></a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr>
                                    <th><input type="text" name="search_browser" placeholder="Search Here" class="form-control input-sm"></th>
                                    <th><input type="text" name="search_browser" placeholder="Search Here" class="form-control input-sm"></th>
                                    <th><input type="text" name="search_browser" placeholder="Search Here" class="form-control input-sm"></th>
                                    <th><input type="text" name="search_browser" placeholder="Search Here" class="form-control input-sm"></th>
                                    <th><input type="text" name="search_browser" placeholder="Search Here" class="form-control input-sm"></th>
                                    <th><input type="text" name="search_browser" placeholder="Search Here" class="form-control input-sm"></th>
                                    <th><input type="text" name="search_browser" placeholder="Search Here" class="form-control input-sm"></th>
                                    <th><input type="text" name="search_browser" placeholder="Search Here" class="form-control input-sm"></th>
                                    <th><input type="text" name="search_browser" placeholder="Search Here" class="form-control input-sm"></th>
                                    <th><input type="text" name="search_browser" placeholder="Search Here" class="form-control input-sm"></th>
                                    <th><input type="text" name="search_browser" placeholder="Search Here" class="form-control input-sm"></th>
                                    <th><input type="text" name="search_browser" placeholder="Search Here" class="form-control input-sm"></th>
                                    <th><input type="text" name="search_browser" placeholder="Search Here" class="form-control input-sm"></th>
                                    <th><input type="text" name="search_browser" placeholder="Search Here" class="form-control input-sm"></th>
                                    <th><input type="text" name="search_browser" placeholder="Search Here" class="form-control input-sm"></th>
                                    <th  class="@ishidden"><input type="text" name="search_browser" placeholder="Search Here" class="form-control input-sm"></th>
                                    <th><input type="text" name="search_browser" placeholder="Search Here" class="form-control input-sm"></th>
                                    <th><input type="text" name="search_browser" placeholder="Search Here" class="form-control input-sm"></th>
                                </tr>
                            </tfoot>
                        </table>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
