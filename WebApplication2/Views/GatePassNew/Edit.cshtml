@model WebApplication1.QueryViewModel.GatePass
@{
    ViewBag.Title = "Edit";

}

<div class="content">
    <div class="content-header">
        <div class="leftside-content-header">
            <ul class="breadcrumbs">
                <li><a><i class="fa fa-cubes" aria-hidden="true"></i> Registration</a></li>
            </ul>
        </div>
    </div>
    <div class="row ">
        <div class="col-sm-12 col-md-12">
            <h4 class="section-subtitle"><b>Create Gate Pass</b></h4>
            <a href="@Url.Action("Index","GatePassNew")" class="btn btn-wide btn-success pull-right" style="margin-top:-40px"><i class="fa fa-list"></i>  List</a>
            @if (Convert.ToString(TempData["succ"]) != "")
            {
                <p class="alert alert-success" style="width:400px;height:50px"><b>@TempData["succ"]</b></p>
            }
            <div class="panel">
                <div class="panel-content">
                    <div class="row">
                        <div class="col-md-12">

                            <form action="Edit" method="post" enctype="multipart/form-data" onsubmit="return confirm('Are you sure you want to Update ?');">
                                <div class="row">
                                    <div class="form-group col-sm-1" style="display:none">
                                        <label> ID</label>
                                        @Html.TextBoxFor(m => m.Id, new { @class = "form-control input-xs", @readonly = "readonly", @required = "required" })
                                    </div>
                                    <div class="form-group col-sm-4">
                                        <label>Date</label>
                                        @if (Session["CurrentUserName"].ToString() == "Super Admin")
                                        {
                                            @Html.TextBoxFor(m => m.Date, new { @class = "form-control input-xs", id = "date", type = "Date", @Value = Model.Date.ToString("yyyy-MM-dd") })
                                        }
                                        else
                                        {

                                            @Html.TextBoxFor(m => m.Date, new { @class = "form-control input-xs", id = "date", type = "Date", @Value = Model.Date.ToString("yyyy-MM-dd"), @readonly = "readonly" })
                                        }
                                    </div>

                                    <div class="form-group col-sm-4">
                                        <label>Customer Name</label>
                                        @Html.DropDownListFor(m => m.CustomerName, new SelectList(ViewBag.Customers as List<WebApplication1.QueryViewModel.Customers>, "Name", "Name"), "Select Customer", htmlAttributes: new { @class = "chosen-select form-control", required = "required" })

                                    </div>

                                    <div class="form-group col-sm-4">
                                        <label>DO. No.</label>
                                        @Html.TextBoxFor(m => m.DoNo, new { @class = "form-control input-xs" })
                                    </div>

                                    <div class="form-group col-sm-4">
                                        <label>Material Detail</label>
                                        @Html.TextBoxFor(m => m.MaterialDetail, new { @class = "form-control input-xs" })
                                    </div>

                                    <div class="form-group col-sm-4">
                                        <label>Driver Name</label>
                                        @Html.TextBoxFor(m => m.DriverName, new { @class = "form-control input-xs" })
                                    </div>
                                    <div class="form-group col-sm-4">
                                        <label>Contact Number</label>
                                        @Html.TextBoxFor(m => m.ContactNumber, new { @class = "form-control input-xs" })
                                    </div>

                                    <div class="form-group col-sm-4">
                                        <label>Vehicle No</label>
                                        @Html.TextBoxFor(m => m.VehicleNo, new { @class = "form-control input-xs" })
                                    </div>

                                    <div class="form-group col-sm-4">
                                        <label>Shipping Detail </label>
                                        @Html.TextBoxFor(m => m.ShippingDetail, new { @class = "form-control input-xs" })
                                    </div>

                                    <div class="form-group col-sm-4">
                                        <label>Time Out</label>
                                        @Html.TextBoxFor(m => m.Timeout, new { @class = "form-control input-xs" })
                                    </div>

                                    <div class="form-group col-sm-4">
                                        <label>Estimate Delivery Time</label>
                                        @Html.TextBoxFor(m => m.EstimateDeliveryTime, new { @class = "form-control input-xs" })
                                    </div>


                                    <div class="col-sm-12">
                                        <button type="submit" class="btn btn-primary" style="margin-top:10px"><i class="fa fa-save"></i> Update</button>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

